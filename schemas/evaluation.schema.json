{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://howtobot.ai/schemas/evaluation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["tutorial_id", "fixture_version", "frozen_before_run", "metrics", "critical_invariants"],
  "properties": {
    "tutorial_id": {"type": "string"},
    "fixture_version": {"type": "string", "minLength": 1},
    "frozen_before_run": {"type": "string", "format": "date-time"},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "numerator", "denominator", "threshold", "comparison"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "numerator": {"type": "string", "minLength": 1},
          "denominator": {"type": "string", "minLength": 1},
          "threshold": {"type": "number", "minimum": 0, "maximum": 1},
          "comparison": {"enum": ["greater_than_or_equal"]}
        }
      }
    },
    "critical_invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "maximum_failures"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "maximum_failures": {"const": 0}
        }
      }
    }
  }
}