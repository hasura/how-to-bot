{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tutorial_id",
    "actions",
    "invalidation"
  ],
  "properties": {
    "tutorial_id": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "class",
          "enforced_by"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "class": {
            "enum": [
              "automatic",
              "supervised_first_run",
              "human_per_action",
              "bounded_batch",
              "prohibited"
            ]
          },
          "enforced_by": {
            "type": "string"
          },
          "approver": {
            "type": [
              "string",
              "null"
            ]
          },
          "preview": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "invalidation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
